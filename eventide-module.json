{
  "name": "imu-datalogger",
  "version": "1.0.0",
  "description": "Logs raw SparkFun Qwiic 9DoF IMU (ICM-20948) data with UTC timestamps.",
  "recordings_subdir": "imu",
  "programs": [
    {
      "name": "imu_datalogger",
      "command": "{venv_python} {module_dir}/imu_logger.py --output-dir {recordings_subdir}",
      "directory": "{module_dir}"
    }
  ]
}
